*{
box-sizing:border-box;
font-family:Arial, sans-serif;
}


body{

margin:0;
background:#fff7ed;

}


.app{

max-width:450px;
margin:auto;
min-height:100vh;
padding:20px;

}



.screen{

background:white;
padding:30px;
border-radius:20px;
box-shadow:0 5px 20px rgba(0,0,0,0.1);

}



.hidden{

display:none;

}



h1{

text-align:center;
color:#d35400;

}



h2{

text-align:center;

}



p{

text-align:center;
line-height:1.5;

}



button{

width:100%;
padding:15px;
margin-top:20px;

border:none;

border-radius:10px;

background:#e67e22;

color:white;

font-size:18px;

cursor:pointer;

}



input,
select{

width:100%;
padding:12px;
margin:10px 0 20px;

border-radius:8px;

border:1px solid #ccc;

}



.cards{

display:grid;

grid-template-columns:1fr 1fr;

gap:15px;

}



.card{

background:#fff3e0;

padding:20px;

border-radius:15px;

text-align:center;

}


.card h3{

margin-bottom:5px;

}